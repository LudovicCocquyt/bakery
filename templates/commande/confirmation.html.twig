{% extends 'base.html.twig' %}

{% block title %}Commande confirmée{% endblock %}

{% block body %}
    <h1>Merci {{ commande.nomClient }} !</h1>
    <p>Ta commande est confirmée pour un retrait le <strong>{{ commande.jourRetrait.jour|capitalize }} {{ commande.dateRetrait|date('d/m/Y') }}</strong>.</p>

    <div class="carte">
        <table>
            <thead>
                <tr><th>Produit</th><th>Quantité</th><th>Prix</th></tr>
            </thead>
            <tbody>
            {% for ligne in commande.lignes %}
                <tr>
                    <td>{{ ligne.libelleComplet }}</td>
                    <td>{{ ligne.quantite }}</td>
                    <td>{{ ligne.prixUnitaire }} €{{ ligne.varianteProduit ? '/kg' : '/pièce' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('commande_index') }}" class="btn secondaire">Passer une autre commande</a>
{% endblock %}
