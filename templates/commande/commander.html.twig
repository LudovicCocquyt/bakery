{% extends 'base.html.twig' %}

{% block title %}Commander pour {{ jourRetrait.jour }}{% endblock %}

{% block body %}
    <p><a href="{{ path('commande_index') }}">&larr; Changer de jour</a></p>
    <h1>Commande pour retrait le {{ jourRetrait.jour|capitalize }} {{ dateRetrait|date('d/m/Y') }}</h1>

    {% if groupes is empty %}
        <p>Aucun produit disponible pour ce jour pour le moment.</p>
    {% else %}
        <form method="post" action="{{ path('commande_traiter', {jour: jourRetrait.jour}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('commande') }}">

            {% for groupe in groupes %}
                <h2 class="nom-categorie">{{ groupe.nom ?: 'Autres produits' }}</h2>

                <div class="grille-produits">
                {% for produit in groupe.produitsPiece %}
                    {% set stock = produit.getStockPourJour(jourRetrait) %}
                    <div class="produit-carte">
                        {% if produit.image %}
                            <img class="produit-image-large" src="/uploads/produits/{{ produit.image }}" alt="{{ produit.nom }}">
                        {% endif %}
                        <div class="produit-contenu">
                            <h3>
                                {{ produit.nom }}
                                {% if produit.description %}
                                    <span class="info-bulle" tabindex="0">i<span class="texte-bulle">{{ produit.description }}</span></span>
                                {% endif %}
                            </h3>
                            <div class="ligne-detail"><span class="libelle-detail">Prix</span><span>{{ produit.prix }} €</span></div>
                            <div class="ligne-detail"><span class="libelle-detail">Stock restant</span><span>{{ stock.stockRestant }}</span></div>
                            <div class="ligne-detail">
                                <span class="libelle-detail">Quantité</span>
                                <span>
                                    {% if stock.estEpuise %}
                                        <span class="badge inactif">Épuisé</span>
                                    {% else %}
                                        <input type="number" name="quantites[{{ produit.id }}]" min="0" max="{{ stock.stockRestant }}" value="0" style="width: 5rem;">
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {% for produit in groupe.produitsKilo %}
                    <div class="produit-carte">
                        {% if produit.image %}
                            <img class="produit-image-large" src="/uploads/produits/{{ produit.image }}" alt="{{ produit.nom }}">
                        {% endif %}
                        <div class="produit-contenu">
                            <h3>
                                {{ produit.nom }}
                                {% if produit.description %}
                                    <span class="info-bulle" tabindex="0">i<span class="texte-bulle">{{ produit.description }}</span></span>
                                {% endif %}
                            </h3>
                            <div class="ligne-detail"><span class="libelle-detail">Prix au kg</span><span>{{ produit.prix }} €</span></div>

                            {% for variante in produit.variantes %}
                                {% set stockVariante = variante.getStockPourJour(jourRetrait) %}
                                {% if stockVariante is not null %}
                                    <div class="sous-carte-variante">
                                        <div class="ligne-detail"><span class="libelle-detail">Format</span><span>{{ variante.libelle }}</span></div>
                                        <div class="ligne-detail"><span class="libelle-detail">Stock restant</span><span>{{ stockVariante.stockRestant }}</span></div>
                                        <div class="ligne-detail">
                                            <span class="libelle-detail">Quantité</span>
                                            <span>
                                                {% if stockVariante.estEpuise %}
                                                    <span class="badge inactif">Épuisé</span>
                                                {% else %}
                                                    <input type="number" name="quantitesVariantes[{{ variante.id }}]" min="0" max="{{ stockVariante.stockRestant }}" value="0" style="width: 5rem;">
                                                {% endif %}
                                            </span>
                                        </div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                {% endfor %}
                </div>
            {% endfor %}

            <div class="carte">
                <h2>Tes coordonnées</h2>
                <label for="nom_client">Nom & prénom</label>
                <input type="text" id="nom_client" name="nom_client" required>

                <label for="email_client">Email</label>
                <input type="email" id="email_client" name="email_client" required>

                <label for="telephone_client">Téléphone (optionnel)</label>
                <input type="tel" id="telephone_client" name="telephone_client">
            </div>

            <button type="submit" class="btn">Valider ma commande</button>
        </form>
    {% endif %}
{% endblock %}
