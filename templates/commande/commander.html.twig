{% extends 'base.html.twig' %}

{% block title %}Commander pour {{ jourRetrait.jour }}{% endblock %}

{% block body %}
    <p><a href="{{ path('commande_index') }}">&larr; Changer de jour</a></p>
    <h1>Commande pour retrait le {{ jourRetrait.jour|capitalize }} {{ dateRetrait|date('d/m/Y') }}</h1>

    {% if groupes is empty %}
        <p>Aucun produit disponible pour ce jour pour le moment.</p>
    {% else %}
        <form method="post" action="{{ path('commande_traiter', {jour: jourRetrait.jour}) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('commande') }}">

            {% for groupe in groupes %}
                <div class="carte">
                    <h2 class="nom-categorie">{{ groupe.nom ?: 'Autres produits' }}</h2>

                    {% if groupe.produitsPiece is not empty %}
                        <table>
                            <thead>
                                <tr><th></th><th>Produit</th><th>Prix</th><th>Stock restant</th><th>Quantité</th></tr>
                            </thead>
                            <tbody>
                            {% for produit in groupe.produitsPiece %}
                                {% set stock = produit.getStockPourJour(jourRetrait) %}
                                <tr>
                                    <td>
                                        {% if produit.image %}
                                            <img class="miniature" src="/uploads/produits/{{ produit.image }}" alt="{{ produit.nom }}">
                                        {% endif %}
                                    </td>
                                    <td>
                                        {{ produit.nom }}
                                        {% if produit.description %}
                                            <span class="info-bulle" tabindex="0">i<span class="texte-bulle">{{ produit.description }}</span></span>
                                        {% endif %}
                                    </td>
                                    <td>{{ produit.prix }} €</td>
                                    <td>{{ stock.stockRestant }}</td>
                                    <td>
                                        {% if stock.estEpuise %}
                                            <span class="badge inactif">Épuisé</span>
                                        {% else %}
                                            <input type="number" name="quantites[{{ produit.id }}]" min="0" max="{{ stock.stockRestant }}" value="0" style="width: 5rem;">
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% endif %}

                    {% for produit in groupe.produitsKilo %}
                        <div style="display: flex; align-items: start; gap: 0.75rem; margin-top: {{ loop.first and groupe.produitsPiece is empty ? '0' : '1.5rem' }};">
                            {% if produit.image %}
                                <img class="miniature" src="/uploads/produits/{{ produit.image }}" alt="{{ produit.nom }}">
                            {% endif %}
                            <div style="flex: 1;">
                                <h3 style="margin: 0 0 0.3rem 0;">
                                    {{ produit.nom }}
                                    {% if produit.description %}
                                        <span class="info-bulle" tabindex="0">i<span class="texte-bulle">{{ produit.description }}</span></span>
                                    {% endif %}
                                </h3>
                                <p style="margin: 0 0 0.5rem 0;"><strong>Prix au kg : {{ produit.prix }} €</strong></p>
                                <table>
                                    <thead>
                                        <tr><th>Format</th><th>Stock restant</th><th>Quantité</th></tr>
                                    </thead>
                                    <tbody>
                                    {% for variante in produit.variantes %}
                                        {% set stock = variante.getStockPourJour(jourRetrait) %}
                                        {% if stock is not null %}
                                            <tr>
                                                <td>{{ variante.libelle }}</td>
                                                <td>{{ stock.stockRestant }}</td>
                                                <td>
                                                    {% if stock.estEpuise %}
                                                        <span class="badge inactif">Épuisé</span>
                                                    {% else %}
                                                        <input type="number" name="quantitesVariantes[{{ variante.id }}]" min="0" max="{{ stock.stockRestant }}" value="0" style="width: 5rem;">
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endif %}
                                    {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}

            <div class="carte">
                <h2>Tes coordonnées</h2>
                <label for="nom_client">Nom & prénom</label>
                <input type="text" id="nom_client" name="nom_client" required>

                <label for="email_client">Email</label>
                <input type="email" id="email_client" name="email_client" required>

                <label for="telephone_client">Téléphone (optionnel)</label>
                <input type="tel" id="telephone_client" name="telephone_client">
            </div>

            <button type="submit" class="btn">Valider ma commande</button>
        </form>
    {% endif %}
{% endblock %}
