{% set config = configuration() %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ config.nomSite }}{% endblock %}</title>
    <style>
        /* Valeurs dynamiques issues de /admin/configuration — le reste des
           styles (mise en page, composants) vit dans les fichiers CSS
           externes ci-dessous, qui les consomment via ces variables. */
        :root {
            --couleur-principale: {{ config.couleurPrincipale }};
            --couleur-texte: {{ config.couleurTexte }};
            --couleur-fond: {{ config.couleurFond }};
            --couleur-bordure: {{ config.couleurBordure }};
            --font-family: {{ config.policeTexte }};
            --taille-texte-base: {{ config.tailleTexteBase }}px;
            --taille-titre1: {{ config.tailleTitre1 }}px;
            --taille-titre2: {{ config.tailleTitre2 }}px;
        }
    </style>
    <link rel="stylesheet" href="/css/app.css">
    <link rel="stylesheet" href="/css/commande.css">
    {% if is_granted('ROLE_ADMIN') %}
        <link rel="stylesheet" href="/css/admin.css">
    {% endif %}
</head>
<body>
    <header>
        <a href="{{ path('commande_index') }}">{{ config.nomSite }}</a>
        <nav>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_commandes_index') }}">Commandes</a>
                {% if config.ficheClientActivee %}
                    <a href="{{ path('admin_clients_index') }}">Clients</a>
                {% endif %}
                <a href="{{ path('admin_parametres_index') }}">Paramètres</a>
                <a href="{{ path('app_logout') }}">Déconnexion</a>
            {% else %}
                {% if config.urlRetourSite %}
                    <a href="{{ config.urlRetourSite }}">{{ config.nomBoutonRetour }}</a>
                {% endif %}
            {% endif %}
        </nav>
    </header>
    <main>
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                <div class="flash {{ type }}">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>
</body>
</html>
