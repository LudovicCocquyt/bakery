{% extends 'base.html.twig' %}

{% block title %}Commandes{% endblock %}

{% macro formulaire_marquer_paye(commande, configuration) %}
    {% if commande.estPayee %}
        <span class="badge-paye">{{ commande.montantPaye }} € payé</span>
    {% else %}
        <form method="post" action="{{ path('admin_commandes_marquer_paye', {id: commande.id}) }}" style="display: flex; gap: 0.4rem; align-items: center; flex-wrap: wrap;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('marquer_paye_' ~ commande.id) }}">
            <input type="text" name="montant" placeholder="Montant €" style="width: 6rem; padding: 0.4rem;" required>
            {% if commande.client and configuration.soldeClientActivee %}
                <select name="mode_paiement" style="padding: 0.4rem; width: auto;">
                    <option value="especes">Espèces / Carte</option>
                    <option value="solde">Solde client</option>
                    <option value="dette">Dette</option>
                </select>
            {% endif %}
            <button type="submit" class="btn secondaire">Marquer payé</button>
        </form>
    {% endif %}
{% endmacro %}

{% block body %}
    <h1>Commandes</h1>

    <div class="carte" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
        <div>
            {% if datePrecedente %}
                <a class="btn secondaire" href="{{ path('admin_commandes_index', {date: datePrecedente|date('Y-m-d')}) }}">&larr; {{ datePrecedente|date('d/m/Y') }}</a>
            {% endif %}
        </div>

        <form method="get" style="margin: 0;">
            <input type="date" name="date" value="{{ dateChoisie|date('Y-m-d') }}"
                   onchange="this.form.submit()"
                   style="padding: 0.5rem; border-radius: 6px; border: 1px solid #d8cdbc;">
        </form>

        <div>
            {% if dateSuivante %}
                <a class="btn secondaire" href="{{ path('admin_commandes_index', {date: dateSuivante|date('Y-m-d')}) }}">{{ dateSuivante|date('d/m/Y') }} &rarr;</a>
            {% endif %}
        </div>
    </div>

    <h2>Retrait du {{ dateChoisie|date('d/m/Y') }} {% if dateChoisie|date('N') <= 5 %}({{ dateChoisie|date('l') }}){% endif %}</h2>

    {% if commandesEnLigne is empty and ventesDirectes is empty %}
        <p>Aucune commande pour cette date.
            {% if datePrecedente %}
                <a href="{{ path('admin_commandes_index', {date: datePrecedente|date('Y-m-d')}) }}">Voir la date précédente avec des commandes ({{ datePrecedente|date('d/m/Y') }})</a>.
            {% endif %}
        </p>
    {% else %}
        <div class="carte" style="background-color: #f6e1cd;">
            <h2>Total à préparer</h2>
            {% for nomCategorie, produits in totauxParCategorie %}
                <h3 class="nom-categorie" style="font-size: 1rem; margin-top: 1rem;">{{ nomCategorie }}</h3>
                <table class="responsive-mobile">
                    <thead><tr><th>Produit</th><th>Quantité totale</th></tr></thead>
                    <tbody>
                    {% for libelle, quantite in produits %}
                        <tr><td data-label="Produit">{{ libelle }}</td><td data-label="Quantité totale"><strong>{{ quantite }}</strong></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% endfor %}
            <p style="margin-top: 0.75rem;">
                {{ (commandesEnLigne|length) + (ventesDirectes|length) }} commande(s) &mdash; {{ nombreArticles }} article(s) en ligne au total
            </p>
        </div>

        <h2>Détail des commandes</h2>
        {% if commandesEnLigne is empty %}
            <p>Aucune commande en ligne pour cette date.</p>
        {% else %}
            {% for commande in commandesEnLigne %}
                <div class="carte">
                    <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 0.5rem;">
                        <div>
                            <strong>Commande #{{ commande.id }}</strong> &mdash; {{ commande.nomClient }} &mdash; {{ commande.emailClient }}
                            {% if commande.telephoneClient %} &mdash; {{ commande.telephoneClient }}{% endif %}
                            {% if commande.client %}
                                &mdash; <a href="{{ path('admin_clients_fiche', {id: commande.client.id}) }}">Voir la fiche</a>
                            {% endif %}
                            <br><small>Commandé le {{ commande.dateCommande|date('d/m/Y H:i') }}</small>
                        </div>
                        <div>{{ _self.formulaire_marquer_paye(commande, configuration) }}</div>
                    </div>

                    <table class="responsive-mobile">
                        <thead><tr><th>Produit</th><th>Quantité</th><th>Prix</th></tr></thead>
                        <tbody>
                        {% for ligne in commande.lignes %}
                            <tr><td data-label="Produit">{{ ligne.libelleComplet }}</td><td data-label="Quantité">{{ ligne.quantite }}</td><td data-label="Prix">{{ ligne.prixUnitaire }} €{{ ligne.varianteProduit ? '/kg' : '/pièce' }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endfor %}
            <p><strong>Total commandes en ligne : {{ commandesEnLigne|length }} commande(s) &mdash; {{ nombreArticles }} article(s)</strong></p>
        {% endif %}

        <h2>Détail des ventes directes</h2>
        {% if ventesDirectes is empty %}
            <p>Aucune vente directe pour cette date.</p>
        {% else %}
            {% for commande in ventesDirectes %}
                <div class="carte">
                    <div style="display: flex; justify-content: space-between; align-items: start; flex-wrap: wrap; gap: 0.5rem;">
                        <div>
                            <strong>Commande #{{ commande.id }}</strong> &mdash; {{ commande.nomClient }} &mdash; {{ commande.emailClient }}
                            {% if commande.telephoneClient %} &mdash; {{ commande.telephoneClient }}{% endif %}
                            {% if commande.client %}
                                &mdash; <a href="{{ path('admin_clients_fiche', {id: commande.client.id}) }}">Voir la fiche</a>
                            {% endif %}
                            <br><small>Vente directe le {{ commande.dateCommande|date('d/m/Y H:i') }}</small>
                        </div>
                        <div>{{ _self.formulaire_marquer_paye(commande, configuration) }}</div>
                    </div>

                    <p>{{ commande.nombreArticlesManuel }} article(s)</p>
                </div>
            {% endfor %}
            <p><strong>Total ventes directes : {{ ventesDirectes|length }} vente(s) &mdash; {{ nombreArticlesVentesDirectes }} article(s)</strong></p>
        {% endif %}
    {% endif %}
{% endblock %}
