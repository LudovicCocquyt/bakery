{% extends 'base.html.twig' %}

{% block title %}Produits{% endblock %}

{% block body %}
    <h1>Produits</h1>
    <p><a href="{{ path('admin_produits_nouveau') }}" class="btn">+ Ajouter un produit</a></p>

    <table>
        <thead>
            <tr><th>Nom</th><th>Prix</th><th>Statut</th><th>Stock par jour</th><th></th></tr>
        </thead>
        <tbody>
        {% for produit in produits %}
            <tr>
                <td>{{ produit.nom }}</td>
                <td>{{ produit.prix }} €</td>
                <td><span class="badge {{ produit.actif ? 'actif' : 'inactif' }}">{{ produit.actif ? 'Actif' : 'Inactif' }}</span></td>
                <td>
                    {% for stock in produit.stocks %}
                        {{ stock.jourRetrait.jour }} : {{ stock.stockRestant }}/{{ stock.stockInitial }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        <em>aucun</em>
                    {% endfor %}
                </td>
                <td>
                    <a href="{{ path('admin_produits_modifier', {id: produit.id}) }}" class="btn secondaire">Modifier</a>
                    <form class="inline" method="post" action="{{ path('admin_produits_supprimer', {id: produit.id}) }}" onsubmit="return confirm('Supprimer ce produit ?');">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('supprimer_produit_' ~ produit.id) }}">
                        <button type="submit" class="btn danger">Supprimer</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="5">Aucun produit pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
